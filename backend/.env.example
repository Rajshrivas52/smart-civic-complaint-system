# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# Option 1: Local MongoDB (requires MongoDB Community Server running locally)
# MONGO_URI=mongodb://127.0.0.1:27017/smart_civic_db

# Option 2: MongoDB Atlas (Cloud - Free Cluster, Recommended)
# Replace <username>, <password>, and cluster domain with your Atlas credentials:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart_civic_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/smart_civic_db

# Authentication
JWT_SECRET=super_secret_jwt_key_smart_civic_2026
JWT_EXPIRES_IN=7d
